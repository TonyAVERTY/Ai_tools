{
  "name": "aitools",
  "version": "0.1.0",
  "private": true,
  "description": "Panel perso de prospection et d'analyse de projets via Claude Code headless, pensé pour Raspberry Pi 4",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file=.env --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --env-file=.env --watch --no-warnings=ExperimentalWarning src/server.js",
    "lint": "node scripts/check-syntax.js",
    "test": "node scripts/run-tests.js",
    "ui:check": "node scripts/run-ui-checks.js",
    "test:mysql": "node --no-warnings=ExperimentalWarning --import ./scripts/test-setup.js --test --test-concurrency=1 \"test/**/*.test.js\"",
    "migrate:sqlite": "node --env-file=.env --no-warnings=ExperimentalWarning scripts/migrate-sqlite-to-mysql.js",
    "check": "npm run lint && npm run test",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "imapflow": "^1.7.8",
    "mysql2": "^3.11.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.0"
  }
}
