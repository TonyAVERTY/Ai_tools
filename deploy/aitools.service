# Template : install.sh remplace @APP_DIR@, @DATA_DIR@ et @APP_USER@.
[Unit]
Description=AiTools (panel prospection IA)
After=network-online.target
Wants=network-online.target
# Ne démarre pas si le disque de données n'est pas monté
RequiresMountsFor=@DATA_DIR@

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
ExecStart=/usr/bin/node --env-file=@APP_DIR@/.env --no-warnings=ExperimentalWarning src/server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
# Le serveur web reste léger ; Claude Code (enfant) tourne déjà en nice 10
Nice=5
MemoryMax=900M
# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA_DIR@ /home/@APP_USER@
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
