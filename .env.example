# URL publique (Cloudflare Tunnel)
APP_URL=https://ai.tony-averty.dev
PORT=3100
HOST=127.0.0.1

# Connexion Google (console.cloud.google.com > Identifiants > ID client OAuth "Application Web")
# URI de redirection autorisée : https://ai.tony-averty.dev/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connexion Apple (facultatif : sans ces 4 variables, le bouton Apple est masqué ; toutes ou aucune)
# developer.apple.com > Identifiers > Services IDs (APPLE_CLIENT_ID), Keys > Sign in with Apple (APPLE_KEY_ID + fichier .p8)
# Domaine et URL de retour à déclarer : https://ai.tony-averty.dev/auth/apple/callback
# APPLE_PRIVATE_KEY : contenu du .p8 sur UNE ligne, les retours à la ligne écrits \n
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=

# Administrateurs (séparés par des virgules). Tout le monde peut créer un compte en se connectant ;
# seuls ces emails sont admins (jobs IA avec la configuration du serveur, tant que la liaison Claude n'existe pas).
# Le premier devient aussi propriétaire des données existantes lors de la migration vers les comptes.
ADMIN_EMAILS=tony.prive35@gmail.com

# Clé de chiffrement des secrets stockés en BDD (mots de passe SMTP/BDD, token Forgejo)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Base de données MySQL / MariaDB (créée dans CloudPanel : Databases > Add Database)
# Les tables sont créées et mises à jour au démarrage (migrations versionnées).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aitools
DB_PASSWORD=
DB_NAME=aitools

# Dossier des clones Git des projets analysés (la base de données n'y est plus stockée)
DATA_DIR=./data

# Claude Code headless
CLAUDE_BIN=claude
# Pause des jobs au-delà de cette température CPU (°C)
THERMAL_MAX=75
