# URL publique (Cloudflare Tunnel)
APP_URL=https://iaboss.fr
PORT=3100
HOST=127.0.0.1

# Connexion Google (console.cloud.google.com > Identifiants > ID client OAuth "Application Web")
# URI de redirection autorisée : https://iaboss.fr/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connexion Apple (facultatif : sans ces 4 variables, le bouton Apple est masqué ; toutes ou aucune)
# developer.apple.com > Identifiers > Services IDs (APPLE_CLIENT_ID), Keys > Sign in with Apple (APPLE_KEY_ID + fichier .p8)
# Domaine et URL de retour à déclarer : https://iaboss.fr/auth/apple/callback
# APPLE_PRIVATE_KEY : contenu du .p8 sur UNE ligne, les retours à la ligne écrits \n
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=

# Administrateurs (séparés par des virgules). Tout le monde peut créer un compte en se connectant ;
# seuls ces emails sont admins (back-office).
# Le premier devient aussi propriétaire des données existantes lors de la migration vers les comptes.
ADMIN_EMAILS=tony.prive35@gmail.com

# Clé de chiffrement des secrets stockés en BDD (mots de passe SMTP/BDD, token Forgejo)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Base de données MySQL / MariaDB (créée dans CloudPanel : Databases > Add Database)
# Les tables sont créées et mises à jour au démarrage (migrations versionnées).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aitools
DB_PASSWORD=
DB_NAME=aitools

# Dossier des clones Git des projets analysés (la base de données n'y est plus stockée)
DATA_DIR=./data

# Claude Code headless
CLAUDE_BIN=claude
# Gemini CLI (npm i -g @google/gemini-cli) : seulement si des utilisateurs relient une clé API Google. Doit être joignable par le bac à sable
# (dans /usr, ou son dossier listé dans SANDBOX_RO_BINDS).
GEMINI_BIN=gemini
# Mode « Connexion avec Claude (abonnement) » : true (défaut) ou false. À false, il est masqué et refusé côté serveur.
CLAUDE_CLI_MODE_ENABLED=true

# Environnement : en production (NODE_ENV=production) tout job IA passe par bubblewrap et est refusé si bwrap manque.
# Posé par deploy/aitools.service ; à poser à la main sous un autre gestionnaire de processus.
# NODE_ENV=production
# Développement seulement : SANDBOX=off lance Claude sans bac à sable (ignoré en production, avertissement au démarrage).
# SANDBOX=off
# Dossiers supplémentaires montés en lecture seule dans le bac à sable (ex. Node ou le CLI installés hors de /usr), séparés par des virgules
# SANDBOX_RO_BINDS=
# Binaire bubblewrap si hors du PATH
# BWRAP_BIN=bwrap

# --- Voix locales des vidéos de promotion (facultatif, rien ne sort du serveur) ---
# Piper : python d'un environnement où `pip install piper-tts` a été fait (ou chemin d'un exécutable piper) + dossier des voix (.onnx et .onnx.json)
# PIPER_BIN=/home/compte/piper/bin/python
# PIPER_VOICES_DIR=/home/compte/piper-voices
# eSpeak NG (paquet espeak-ng) si hors du PATH
# ESPEAK_BIN=espeak-ng

# --- Anti-abus, plafonds et administration (jalon J5) ---
# Derrière Nginx / CloudPanel : lire X-Forwarded-For, mais seulement depuis un proxy de confiance.
# false (défaut) | true (proxy local 127.0.0.0/8 et ::1) | liste d'adresses ou de plages CIDR séparées par des virgules
TRUST_PROXY=false

# Google reCAPTCHA v3 sur la connexion (console.google.com/recaptcha, type v3, domaine iaboss.fr).
# Les deux clés ensemble, ou aucune (désactivé : développement). Le script de Google n'est chargé qu'après un clic de l'utilisateur.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# Score minimal accepté (0 à 1)
RECAPTCHA_MIN_SCORE=0.5

# Pas de limite globale de jobs IA : la limite vient de l'offre de chaque compte (1 en gratuit, jusqu'à 6 en Intensif, voir parallelJobs dans src/limits.js).
# MAX_AI_JOBS n'existe plus : s'il est resté dans ton .env, il est simplement ignoré.
# Les nouveaux jobs attendent quand charge moyenne (1 min) / nombre de cœurs dépasse cette valeur (remplace THERMAL_MAX)
LOAD_MAX=0.9

# Hôtes privés (127.0.0.1, 10.x, 192.168.x…) autorisés pour SMTP, IMAP, base du récap et Forgejo, et tous les ports.
# Développement seulement ; en production, réservé aux comptes administrateurs. Laisser à false sinon.
ALLOW_PRIVATE_HOSTS=false

# Comptes inactifs : suppression après ce nombre de mois sans connexion ni job (0 = désactivé), avertissement 30 jours avant.
INACTIVE_ACCOUNT_MONTHS=24
# SMTP du serveur : tous les mails envoyés PAR AiTools (invitations d'équipe, rapport hebdo, résultat d'« Évolution »,
# avertissement d'inactivité). Les mails de prospection et de relance partent, eux, du SMTP de chaque PROJET.
# Toutes les variables ensemble, ou aucune : sans lui, aucun de ces mails ne part (plus d'invitation possible) et
# l'avertissement d'inactivité est seulement journalisé : AUCUN compte n'est alors supprimé automatiquement.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_SMTP_FROM=
# Facultatif. Adresse de contact : les réponses aux mails d'AiTools (invitations, rapports…) arrivent dessus.
SYSTEM_SMTP_REPLY_TO=
# Facultatif. Boîte dédiée aux alertes d'erreur serveur envoyées aux administrateurs : même serveur et MÊME mot de passe
# (SYSTEM_SMTP_PASSWORD), seul l'identifiant change. Sans elle, les alertes partent de SYSTEM_SMTP_FROM.
SYSTEM_SMTP_ERROR_USER=

# LinkedIn : relier un compte à un projet et publier des posts écrits par Claude. Désactivé tant que les deux valeurs sont vides.
# Crée une application sur developer.linkedin.com, ajoute-lui les produits « Sign In with LinkedIn using OpenID Connect » et
# « Share on LinkedIn », et déclare l'URL de redirection ci-dessous (APP_URL + /linkedin/callback).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=https://iaboss.fr/linkedin/callback
# Droits demandés à LinkedIn (défaut : openid profile w_member_social = publier sur le profil).
# Publier sur une PAGE demande l'accès « Community Management API », qui doit être le SEUL produit de son application
# (application dédiée, sans « Share » ni « Sign In », donc sans openid) :
# LINKEDIN_SCOPES=w_organization_social rw_organization_admin
# Version de l'API LinkedIn (AAAAMM) :
# LINKEDIN_API_VERSION=202604
